# FKTee-rs SELinux 规则
# 参考 OMK 的极简策略 + HAL 模式 / prop 隐藏额外规则。

# ===== inject 路径（keystore2 exec inject 二进制 + payload）=====
# keystore2 需执行 inject 二进制并 mmap payload .so
allow keystore system_file unix_dgram_socket { getattr read recvfrom }
allow system_file keystore unix_dgram_socket sendto
allow keystore system_file file { execute getattr map read receive }
# 回退：允许 keystore 读 system_data_file / magisk_file（/data/ 下文件的默认类型）
allow keystore system_data_file file { getattr map read }
allow keystore magisk_file file { getattr map read }
# crash_dump 读取 keystore2 内存（注入调试用）
allow crash_dump keystore process *

# ===== HAL 模式（fktee-hal 作为 KeyMint HAL 服务）=====
# 1. HAL 进程（magisk 域）向 servicemanager 注册 / 查找 service
allow magisk default_android_service service_manager { add find }
allow keystore default_android_service service_manager { find }
# 2. keystore2 ↔ HAL 进程经 binder 双向通信
allow keystore magisk binder { call transfer }
allow magisk keystore binder { call transfer }
# 3. HAL 进程查找真 HAL（fktee-real 实例）
allow magisk hal_keymint_server binder { call transfer }
allow hal_keymint_server magisk binder { call transfer }
# 4. HAL 进程读取配置 / keybox / 黑名单 / packages.list
allow magisk magisk_file file { read open getattr }
allow magisk magisk_file dir { read search }
allow magisk system_data_file file { read open getattr }
allow magisk system_data_file dir { search }
# 5. HAL 进程写入日志
allow magisk magisk_file file { write create append }
allow magisk magisk_file dir { write add_name }
# 6. vintf bind mount（service.sh late_start 阶段）
allow magisk self capability { sys_admin }
allow magisk vendor_configs_file file { read getattr mount }
allow magisk vendor_configs_file dir { read search mounton }
allow magisk odm_configs_file file { read getattr mount }
allow magisk odm_configs_file dir { read search mounton }
allow magisk tmpfs filesystem { mount }

# ===== prop 隐藏（resetprop 由 magisk 域执行）=====
allow magisk default_prop property_service { set }
allow magisk default_prop property_type { set }
