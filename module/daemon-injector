#!/system/bin/sh
# daemon-injector - inject watchdog
# Keeps the inject binary running AND ensures keystore2 stays injected.
# If keystore2 is found but our lib is no longer in its maps, re-inject.
# 15s cooldown debounce to avoid hammering a restarting keystore2.
# Honors restart signal: /data/adb/Tee-rs/restart.injector  (or restart.all)

MODDIR=${0%/*}
TEERS_DIR=/data/adb/Tee-rs
PIDFILE="$TEERS_DIR/data/injector.pid"
ARCH=$(getprop ro.product.cpu.abi)
BIN="$MODDIR/libs/$ARCH/inject"
# payload 与配置的绝对路径——显式传给 inject，避免 injector 自动模式读取
# 不存在的 /data/adb/Tee-rs/injector.payload（payload 实际在 $MODPATH/libs/$ARCH/）。
PAYLOAD="$MODDIR/libs/$ARCH/injector.payload"
CONFIG="$TEERS_DIR/injector.toml"

COOLDOWN=15        # seconds: wait after an inject attempt before retrying
CHECK_INTERVAL=5   # seconds: how often to verify injection state
# Marker name this injector leaves in keystore2 maps（payload 文件名片段）
INJECT_MARKER="injector.payload"

# ---------- Helpers ----------
# Locate the keystore2 process id
get_keystore_pid() {
    for p in /proc/[0-9]*; do
        pid=${p##*/}
        # cmdline is null-separated; tr to space for grep
        if tr '\0' ' ' < "$p/cmdline" 2>/dev/null | grep -q "keystore2"; then
            echo "$pid"
            return 0
        fi
    done
    return 1
}

# Is keystore2 currently running?
keystore_alive() {
    [ -n "$(get_keystore_pid)" ]
}

# Is keystore2 still carrying our injected lib?
is_injected() {
    pid=$(get_keystore_pid)
    [ -z "$pid" ] && return 1
    grep -q "$INJECT_MARKER" "/proc/$pid/maps" 2>/dev/null
}

is_injector_running() {
    [ -f "$PIDFILE" ] || return 1
    pid=$(cat "$PIDFILE" 2>/dev/null)
    [ -n "$pid" ] && [ -d "/proc/$pid" ]
}

start_inject() {
    [ -x "$BIN" ] || return 1
    [ -f "$PAYLOAD" ] || return 1
    # 显式传 <pid> <payload> <config>，不依赖 injector 自动模式的硬编码路径
    ks=$(get_keystore_pid)
    [ -n "$ks" ] || return 1
    rm -f "$PIDFILE"
    "$BIN" "$ks" "$PAYLOAD" "$CONFIG" &
    echo $! > "$PIDFILE"
}

# ---------- Main loop ----------
while true; do
    # Consume restart signals
    if [ -f "$TEERS_DIR/restart.injector" ] || [ -f "$TEERS_DIR/restart.all" ]; then
        [ -f "$TEERS_DIR/restart.injector" ] && rm -f "$TEERS_DIR/restart.injector"
        if is_injector_running; then
            kill "$(cat "$PIDFILE")" 2>/dev/null
            rm -f "$PIDFILE"
        fi
        start_inject
        sleep "$COOLDOWN"
        continue
    fi

    # If injector process died, restart it
    if ! is_injector_running; then
        start_inject
        sleep "$COOLDOWN"
        continue
    fi

    # Verify keystore2 is still injected; re-inject if not
    if keystore_alive; then
        if ! is_injected; then
            start_inject
            sleep "$COOLDOWN"
            continue
        fi
    fi

    sleep "$CHECK_INTERVAL"
done
