#!/system/bin/sh
# daemon - fktee backend watchdog（参考 OMK daemon 架构）
#
# while true 循环：启动 fktee → kill -0 监控存活 → 收到 restart 信号或
# 子进程退出时重启。restart 信号由 WebUI 触发（touch restart.fktee）。
#
# 与 OMK 不同：fktee 是常驻进程（提供 binder service），不会主动退出。
# 退出即视为异常，自动重启 + 指数退避。

MODDIR=${0%/*}
TEERS_DIR=/data/adb/Tee-rs
STATE_DIR=$TEERS_DIR/data
RESTART_FILE=$TEERS_DIR/restart.fktee
RESTART_ALL_FILE=$TEERS_DIR/restart.all
ARCH=$(getprop ro.product.cpu.abi)

# 启动时先写一条日志，确认 daemon 脚本确实执行了
mkdir -p "$TEERS_DIR/logs" 2>/dev/null
echo "[fktee-daemon] daemon watchdog started at $(date 2>/dev/null || echo 'unknown')" >>"$TEERS_DIR/logs/fktee.log" 2>/dev/null

export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:/vendor/lib64/:/system/lib64/:/apex/com.android.runtime/lib64/bionic/"
# env_logger 默认 WARN 级别，不设 RUST_LOG 则 info! 日志全部丢失，fktee.log 看起来是空的
export RUST_LOG="${RUST_LOG:-info}"

find_module_fktee() {
  if [ -f "$STATE_DIR/fktee" ]; then
    echo "$STATE_DIR/fktee"
    return 0
  fi
  if [ -f "$MODDIR/libs/$ARCH/fktee" ]; then
    echo "$MODDIR/libs/$ARCH/fktee"
    return 0
  fi
  return 1
}

expand_shared_restart() {
  if [ -f "$RESTART_ALL_FILE" ]; then
    : > "$RESTART_FILE"
    : > "$TEERS_DIR/restart.injector"
    : > "$TEERS_DIR/restart.hal"
    rm -f "$RESTART_ALL_FILE"
  fi
}

consume_restart_request() {
  expand_shared_restart
  if [ -f "$RESTART_FILE" ]; then
    rm -f "$RESTART_FILE"
    return 0
  fi
  return 1
}

cd "$MODDIR" || exit 1
mkdir -p "$STATE_DIR" "$TEERS_DIR/logs"

while true; do
  TARGET=$(find_module_fktee)
  if [ -z "$TARGET" ]; then
    echo "[fktee-daemon] fktee binary not found" >>"$TEERS_DIR/logs/fktee.log"
    sleep 5
    continue
  fi

  chmod 0755 "$TARGET" 2>/dev/null || true

  "$TARGET" >>"$TEERS_DIR/logs/fktee.log" 2>&1 &
  child_pid=$!

  while kill -0 "$child_pid" 2>/dev/null; do
    if consume_restart_request; then
      echo "[fktee-daemon] restart requested" >>"$TEERS_DIR/logs/fktee.log"
      kill -TERM "$child_pid" 2>/dev/null
      sleep 2
      if kill -0 "$child_pid" 2>/dev/null; then
        kill -KILL "$child_pid" 2>/dev/null
      fi
      break
    fi
    sleep 2
  done

  wait "$child_pid"
  rc=$?
  echo "[fktee-daemon] fktee exited with code $rc" >>"$TEERS_DIR/logs/fktee.log"
  sleep 2
done
